{
  "name": "abroad-o-public-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "serve:site": "eleventy --serve",
    "check:site": "npm run check:contracts && npm run build:site && node scripts/check-site.mjs",
    "check:contracts": "node --test scripts/test-html-contract.mjs",
    "check:redirects": "node scripts/check-apache-redirects.mjs",
    "check:a11y": "npm run build:site && node scripts/check-a11y.mjs",
    "check:modern-ui": "npm run build:site && node scripts/check-modern-ui.mjs",
    "check:legacy-ui": "npm run build:site && node scripts/check-legacy-ui.mjs && node scripts/test-legacy-ui-negative.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@axe-core/playwright": "4.13.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@playwright/test": "1.62.1",
    "@popperjs/core": "2.11.8",
    "bootstrap": "5.3.8",
    "bootstrap3": "npm:bootstrap@3.4.1",
    "gray-matter": "4.0.3",
    "jquery": "3.7.1",
    "lightbox2": "2.12.0",
    "parse5": "8.0.1"
  }
}
