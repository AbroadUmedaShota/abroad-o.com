<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ description | escape }}">
<title>{{ title | escape }}</title>
<link rel="canonical" href="{{ canonicalUrl | escape }}">
<meta name="google-site-verification" content="{{ site.googleSiteVerification | escape }}">
<link rel="stylesheet" href="/css/fonts.css">
{% if preloadTopImage %}<link rel="preload" as="image" href="/image/top1.webp" type="image/webp" fetchpriority="high">{% endif %}
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<meta property="og:title" content="{{ (ogTitle or title) | escape }}">
<meta property="og:description" content="{{ (ogDescription or description) | escape }}">
<meta property="og:type" content="{{ (ogType or ('article' if tags and 'newsArticle' in tags else 'website')) | escape }}">
<meta property="og:url" content="{{ canonicalUrl | escape }}">
<meta property="og:site_name" content="{{ site.name | escape }}">
<meta property="og:locale" content="{{ site.locale | escape }}">
<meta property="og:image" content="{{ (ogImage or site.defaultOgImageUrl) | escape }}">
<meta property="og:image:alt" content="{{ (ogImageAlt or site.defaultOgImageAlt) | escape }}">
<meta property="og:image:width" content="1990">
<meta property="og:image:height" content="810">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ (ogTitle or title) | escape }}">
<meta name="twitter:description" content="{{ (ogDescription or description) | escape }}">
<meta name="twitter:image" content="{{ (ogImage or site.defaultOgImageUrl) | escape }}">
<meta name="twitter:image:alt" content="{{ (ogImageAlt or site.defaultOgImageAlt) | escape }}">
{% if structuredData %}<script type="application/ld+json">{{ structuredData | safe }}</script>{% endif %}
