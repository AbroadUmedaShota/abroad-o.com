{% block scripts %}
{% include "partials/scripts-legacy-core.njk" %}
    <!-- ふわっと表示jQuery -->
    <script src="js/box-fadeup.js"></script>
    <script>
         $('a').smoothScroll();
    </script>
    <!-- スクロールボタン表示jQuery -->
    <script>
    $(function() {
        var showFlag = false;
        var topBtn = $('#page-top');
        topBtn.css('bottom', '-150px');
        var showFlag = false;
        $(window).scroll(function () {
            if ($(this).scrollTop() > 300) {//スクロールが300に達したらボタン表示
                if (showFlag == false) {
                    showFlag = true;
                    topBtn.stop().animate({'bottom' : '20px'}, 300); //スクロールボタンのmargin-bottm
                }
            } else {
                if (showFlag) {
                    showFlag = false;
                    topBtn.stop().animate({'bottom' : '-200px'}, 300); //上に-200pxスクロールしたら消える
                }
            }
    });
    //スクロールしてトップ
    topBtn.click(function () {
        $('body,html').animate({
            scrollTop: 0
        }, 500);
        return false;
    });
    });
    </script>
    <!-- Footer Year Update -->
    <script>
      document.getElementById('current-year').textContent = new Date().getFullYear();
    </script>
{% endblock %}
