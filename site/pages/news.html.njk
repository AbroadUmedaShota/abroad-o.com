---
permalink: "/news.html"
title: "アブロードアウトソーシング株式会社│お知らせ一覧"
description: "アブロードアウトソーシング株式会社からのお知らせ、休業案内、認証取得情報を掲載しています。"
canonicalUrl: "https://www.abroad-o.com/news.html"
layoutVariant: "legacy"
activeNav: "news"
scriptsVariant: "news"
---
{% extends "layouts/site.njk" %}

{% block headExtras %}
    {% include "partials/styles-legacy-core.njk" %}
    <link href="style.css" rel="stylesheet">
    <link rel="icon" href="image/favicon.png" type="image/png">
<link rel="stylesheet" href="/css/pages/news-index.css">
{% endblock %}

{% block main %}
<main>
  <section id="title_top">
    <div class="container">
      <h1>NEWS</h1>
    </div><!--container-->
  </section>
  <section id="news_list" class="container news-list-spacing">
{% for article in collections.newsArticles %}
    <article class="news-summary-item{% if article.data.summaryClass %} {{ article.data.summaryClass }}{% endif %}">
      <p class="news-date">{{ article.data.displayDate }}</p>
      <h2><a href="{{ article.url }}">{{ article.data.summaryTitle }}</a></h2>
      <p class="news-excerpt">{{ article.data.excerpt }}</p>
      <p class="read-more"><a href="{{ article.url }}">続きを読む &raquo;</a></p>
    </article>
{% endfor %}
  </section>
</main>
{% endblock %}
