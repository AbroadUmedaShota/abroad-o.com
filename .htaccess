<IfModule mod_rewrite.c>
RewriteEngine On

# Canonicalize root documents in one hop before scheme and host redirects.
RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?(?:[?\s]) [NC]
RewriteRule ^index(?:\.html)?$ https://www.abroad-o.com/ [R=301,L,NE]

# Canonicalize scheme and host in a single redirect without reflecting Host.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.abroad-o\.com$ [NC]
RewriteRule ^(.*)$ https://www.abroad-o.com/$1 [R=301,L,NE]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://www.google-analytics.com https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self'; style-src-attr 'none'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; font-src 'self'; connect-src 'self' https://abroad-o-contact-form.abroad-o.workers.dev https://www.google-analytics.com; frame-src 'self' https://www.google.com https://challenges.cloudflare.com; frame-ancestors 'self'; form-action 'self'"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
