<IfModule mod_rewrite.c>
RewriteEngine On

# Canonicalize root documents in one hop before scheme and host redirects.
RewriteRule ^index(?:\.html)?$ https://www.abroad-o.com/ [R=301,L,NE]

# Canonicalize scheme and host in a single redirect without reflecting Host.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.abroad-o\.com$ [NC]
RewriteRule ^(.*)$ https://www.abroad-o.com/$1 [R=301,L,NE]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
